OPENAI_API_KEY=your-openai-api-key

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=react-compass

MODEL_NAME=gpt-5-nano
MODEL_ARGS__USE_RESPONSES_API=true
MODEL_ARGS__REASONING__EFFORT="minimal"
EMBEDDING_MODEL=text-embedding-3-small

# Local Chroma (default for development)
CHROMA_PATH=../data/embeddings

# Chroma Cloud (set all three in production; CHROMA_PATH is then ignored)
# CHROMA_API_KEY=your-chroma-cloud-api-key
# CHROMA_TENANT=your-chroma-cloud-tenant
# CHROMA_DATABASE=react-docs

REACT_DEV_ROOT=../react.dev/src/content
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
