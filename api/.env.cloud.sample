# Copy to .env.cloud and fill in the production credentials from Vercel.
# This file is loaded explicitly; api/.env and ambient credentials are not used.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=react-docs
CHROMA_COLLECTION=react-docs

# Must match the embedding model used by the deployed API.
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Relative paths are resolved from this environment file's directory.
REACT_DEV_ROOT=../react.dev/src/content
